+    /// STRATA_Q36_LOOKUP=1 (prompt lookup decoding): x_tok and the D drafts taken from an earlier match of the text's tail
+    /// in one verify window (the MTP path's window and commit); the accepted drafts' count is returned, picks[0 .. a] the
+    /// greedy tokens after x and after each accepted draft.
+    int lookup_step(int x_tok, int D, const int32_t* drafts, int32_t* picks) {
+        const int N = (int) m->g.n_embd;
+        if (main_hybrid) D = std::min<int>(D, (int) (kRebalanceEvery - pos % kRebalanceEvery) - 1);
+        D = std::max(0, std::min(D, kVerify - 1));
+        const int T = D + 1;
+        CK(cudaStreamSynchronize(st));
+        hpin[16] = x_tok;
+        for (int d = 0; d < D; ++d) hpin[17 + d] = drafts[d];
+        hpin[1] = (int32_t) pos;
+        CK(cudaMemcpyAsync(tok, hpin + 16, (size_t) T * 4, cudaMemcpyHostToDevice, st));
+        CK(cudaMemcpyAsync(pos0, hpin + 1, 4, cudaMemcpyHostToDevice, st));
+        rows_deferred = true;
+        graph_run(gs().gv[T], [&] { forward(T, pos, T, use_graph, true); });
+        rows_deferred = false;
+        CK(cudaMemcpyAsync(hpin + 2, pick, (size_t) T * 4, cudaMemcpyDeviceToHost, st));
+        CK(cudaStreamSynchronize(st));
+        int a = 0;
+        while (a < D && hpin[2 + a] == drafts[a]) ++a;
+        for (int i = 0; i <= a; ++i) picks[i] = hpin[2 + i];
+        commit(a + 1);
+        CK(cudaMemcpyAsync(hlast, hmain + (size_t) a * N, (size_t) N * 4, cudaMemcpyDeviceToDevice, st));
+        pos += a + 1;
+        after_rows(a + 1);
+        lk_pass += 1;
+        lk_drafted += D;
+        lk_acc += a;
+        lk_ema = 0.8 * lk_ema + 0.2 * (D > 0 ? (double) a / D : 0.0);
+        if (lk_ema < 0.25) { lk_cool = 16; lk_ema = 0.5; }
+        sp_balance();
+        return a;
+    }
+    long long lk_pass = 0, lk_drafted = 0, lk_acc = 0;
+    double lk_ema = 0.5;   // the recent acceptance rate; below 0.25 the lookup pauses (lk_cool steps)
+    int lk_cool = 0;
+    void sp_balance() {   // STRATA_Q36_SPLIT auto: more to the GPU while the pool is the longer side
+        if (sp_stage && sp_auto && sp_tok_pool + sp_tok_copy > 0) {
+            const double r = (sp_tok_pool - sp_tok_copy) / (sp_tok_pool + sp_tok_copy);
+            sp_frac = std::min(0.95, std::max(0.05, sp_frac + 0.05 * r));
+            sp_tok_pool = sp_tok_copy = 0;
+        }
+    }
