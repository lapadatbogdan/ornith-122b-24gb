+namespace {
+// The mapped expert pack (see map_pack): an expert that sits in a VRAM slot is not read on the host, so its pages are
+// dropped from this mapping and from the page cache. The RAM then holds the experts the CPU pool computes, instead of
+// a second copy of the ones on the card (on 32 GB, 13.7 GiB of slot experts pushed the CPU's experts out to the disk).
+int g_pack_fd = -1;
+const uint8_t* g_pack_map = nullptr;
+void pack_drop(const uint8_t* ptr, size_t len) {
+    if (g_pack_fd < 0 || !g_pack_map || ptr < g_pack_map) return;
+    const size_t pg = (size_t) sysconf(_SC_PAGESIZE);
+    const size_t off = (size_t) (ptr - g_pack_map);
+    const size_t a = (off + pg - 1) / pg * pg, b = (off + len) / pg * pg;
+    if (b <= a) return;
+    static long long n_ok = 0, n_fail = 0;
+    const int r1 = madvise((void*) (g_pack_map + a), b - a, MADV_DONTNEED);
+    const int r2 = posix_fadvise(g_pack_fd, (off_t) a, (off_t) (b - a), POSIX_FADV_DONTNEED);
+    if (r1 == 0 && r2 == 0) ++n_ok;
+    else if (++n_fail <= 3) std::fprintf(stderr, "strata-q36: pack_drop failed (madvise %d errno %d, fadvise %d) at %zu+%zu\n", r1, errno, r2, a, b - a);
+    if (std::getenv("STRATA_Q36_PACK_DEBUG") && (n_ok + n_fail) % 1000 == 0)
+        std::fprintf(stderr, "strata-q36: pack_drop %lld ok %lld failed\n", n_ok, n_fail);
+}
+}  // namespace
+#else
+namespace { void pack_drop(const uint8_t*, size_t) {} }
+#endif
