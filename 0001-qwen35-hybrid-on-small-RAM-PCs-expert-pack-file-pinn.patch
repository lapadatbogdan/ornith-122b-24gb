+            return;
+        }
+        if (!swap_pin || n > swap_pin_slot) {
+            if (swap_pin) { CK(cudaStreamSynchronize(st)); CK(cudaFreeHost(swap_pin)); }
+            swap_pin_slot = n;
+            CK(cudaHostAlloc((void**) &swap_pin, swap_pin_slot * kSwapPinSlots, cudaHostAllocDefault));
+            swap_pin_used = 0;
+        }
+        if (swap_pin_used == kSwapPinSlots) {   // the ring is full: let the stream drain it
+            CK(cudaStreamSynchronize(st));
+            swap_pin_used = 0;
+        }
+        uint8_t* p = swap_pin + swap_pin_used++ * swap_pin_slot;
+        std::memcpy(p, src, n);
+        CK(cudaMemcpyAsync(dst, p, n, cudaMemcpyHostToDevice, st));
+        pack_drop(src, n);   // the expert lives in its slot now
+    }
