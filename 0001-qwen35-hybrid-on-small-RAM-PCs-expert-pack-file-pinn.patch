@@ -2793,6 +2902,119 @@ struct Engine {
 /// The routed experts after the engine's buffers: all in VRAM when they fit in `vram_gib` (< 0: the free VRAM less a
 /// reserve), else the hybrid mode - every expert in host memory, the same number of VRAM slots per layer, a decode
 /// batch's other experts on the CPU pool and a prompt chunk's streamed through two staging buffers.
+
+// ------------------------------------------------------------------------------------------------ host expert pack
+// The hybrid mode keeps every routed expert in host memory, in the engine's [gate | up | down] layout. On a PC whose RAM
+// holds that copy (plus the system and the mapped GGUF) it is an arena, pinned where the driver allows it. When it does
+// not (Ornith-1.5-122B's 41 GiB of IQ3_XXS / IQ2_S experts on 32 GB), copying into an anonymous arena only swaps: the
+// copy is written once to a pack file next to the GGUF and mapped read-only instead, so the page cache keeps the
+// experts the routing uses and reads the rest from the disk. STRATA_Q36_PACK=1 always uses the pack, =0 never;
+// STRATA_Q36_PACK_FILE names it (default: <gguf>.q36pack).
+#if !defined(_WIN32)
+namespace {
+constexpr size_t kPackHeader = 4096;
+struct PackHeader {
+    char magic[8];
+    uint64_t version, gguf_size, gguf_mtime, n_layers, n_expert, payload;
+    uint64_t strides[64];
+};
+
+size_t ram_bytes() {
+    const long pages = sysconf(_SC_PHYS_PAGES), page = sysconf(_SC_PAGESIZE);
+    return pages > 0 && page > 0 ? (size_t) pages * (size_t) page : 0;
+}
+
+bool want_pack(size_t host) {
+    const char* v = std::getenv("STRATA_Q36_PACK");
+    if (v && *v) return std::strcmp(v, "0") != 0;
+    const size_t ram = ram_bytes();
+    // the copy, the mapped GGUF's working set and the system: an arena only when the copy leaves a quarter of the RAM
+    return ram > 0 && host > ram / 4 * 3;
+}
+
+// Maps the pack (building it first when it is missing or was made from another file); nullptr with err on failure.
+uint8_t* map_pack(const Model& m, const std::vector<Layer*>& layers, size_t host, std::string& err) {
+    const char* named = std::getenv("STRATA_Q36_PACK_FILE");
+    const std::string path = named && *named ? std::string(named) : m.path + ".q36pack";
+    struct stat gs {};
+    if (stat(m.path.c_str(), &gs) != 0) {
+        err = "cannot stat " + m.path;
+        return nullptr;
+    }
+    PackHeader want {};
+    std::memcpy(want.magic, "Q36PACK1", 8);
+    want.version = 1;
+    want.gguf_size = (uint64_t) gs.st_size;
+    want.gguf_mtime = (uint64_t) gs.st_mtime;
+    want.n_layers = layers.size();
+    want.n_expert = (uint64_t) m.g.n_expert;
+    want.payload = host;
+    if (layers.size() > 64) {
+        err = "more than 64 hybrid layers for the pack header";
+        return nullptr;
+    }
+    for (size_t i = 0; i < layers.size(); ++i) want.strides[i] = layers[i]->stride;
+    bool ok = false;
+    {
+        const int fd = open(path.c_str(), O_RDONLY);
+        if (fd >= 0) {
+            PackHeader have {};
+            struct stat ps {};
+            ok = read(fd, &have, sizeof(have)) == (ssize_t) sizeof(have) && std::memcmp(&have, &want, sizeof(want)) == 0 &&
+                 fstat(fd, &ps) == 0 && (size_t) ps.st_size == kPackHeader + host;
+            close(fd);
+        }
+    }
+    if (!ok) {
+        const auto t0 = Clock::now();
+        std::fprintf(stderr, "strata-q36: writing the expert pack %s (%.2f GiB, once) ...\n", path.c_str(),
+                     (double) host / (1 << 30));
+        const std::string tmp = path + ".tmp";
+        FILE* f = std::fopen(tmp.c_str(), "wb");
+        if (!f) {
+            err = "cannot write " + tmp + " (STRATA_Q36_PACK_FILE names another place, STRATA_Q36_PACK=0 uses RAM)";
+            return nullptr;
+        }
+        std::vector<uint8_t> head(kPackHeader, 0);
+        std::memcpy(head.data(), &want, sizeof(want));
+        bool w = std::fwrite(head.data(), 1, head.size(), f) == head.size();
+        for (const Layer* L : layers) {
+            std::vector<uint8_t> blob(L->stride, 0);
+            for (int64_t e = 0; w && e < m.g.n_expert; ++e) {
+                std::fill(blob.begin(), blob.end(), 0);
+                expert_blob(*L, e, blob.data());
+                w = std::fwrite(blob.data(), 1, blob.size(), f) == blob.size();
+            }
+            const std::vector<uint8_t> tail(kMmqTail, 0);
+            w = w && std::fwrite(tail.data(), 1, tail.size(), f) == tail.size();
+        }
+        w = std::fflush(f) == 0 && fsync(fileno(f)) == 0 && w;
+        w = std::fclose(f) == 0 && w;
+        if (!w || std::rename(tmp.c_str(), path.c_str()) != 0) {
+            std::remove(tmp.c_str());
+            err = "writing the expert pack " + path + " failed (disk full?)";
+            return nullptr;
+        }
+        std::fprintf(stderr, "strata-q36: expert pack written in %.1f s\n", ms_since(t0) / 1000.0);
+    }
+    const int fd = open(path.c_str(), O_RDONLY);
+    if (fd < 0) {
+        err = "cannot open " + path;
+        return nullptr;
+    }
+    void* p = mmap(nullptr, kPackHeader + host, PROT_READ, MAP_SHARED, fd, 0);
+    if (p == MAP_FAILED) {
+        close(fd);
+        err = "cannot map " + path;
