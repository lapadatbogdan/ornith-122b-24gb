     /// The slots to the experts the routing used most (the counts halved each time): at most max_swaps replacements
     /// over all layers, between forwards (the copies are on the engine's stream).
+    // Slot copies from a pageable host copy (a mapped pack file): HIP pins every pageable source on the fly (a kfd
+    // ioctl per chunk), which made each swap take tens of ms and the main thread spin. Copy the blob into a small
+    // pinned ring first, then DMA from there; the ring is reused after the stream has drained it.
+    uint8_t* swap_pin = nullptr;
+    size_t swap_pin_slot = 0, swap_pin_used = 0;
+    static constexpr size_t kSwapPinSlots = 8;
+    void swap_copy(uint8_t* dst, const uint8_t* src, size_t n) {
