+// Host -> device copy of a pageable source through a pinned bounce buffer. A direct cudaMemcpy from a file mapping
+// makes the ROCm driver pin the source pages (userptr) and they then stay resident: on a 32 GB PC the GGUF's dense
+// weights and the slot experts read from the pack kept ~20 GiB of file pages in RAM that nothing reads again.
+void h2d_bounce(void* dst, const void* src, size_t n) {
+    static uint8_t* pin = nullptr;
+    static constexpr size_t kChunk = (size_t) 64 << 20;
+    if (!pin) CK(cudaHostAlloc((void**) &pin, kChunk, cudaHostAllocDefault));
+    for (size_t o = 0; o < n; o += kChunk) {
+        const size_t c = std::min(kChunk, n - o);
+        std::memcpy(pin, (const uint8_t*) src + o, c);
+        CK(cudaMemcpy((uint8_t*) dst + o, pin, c, cudaMemcpyHostToDevice));
+    }
+}
